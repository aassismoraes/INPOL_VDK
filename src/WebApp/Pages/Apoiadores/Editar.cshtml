@page "{id:guid}"
@model WebApp.Pages.Apoiadores.EditarModel
@{
    ViewData["Title"] = "Editar Apoiador";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Editar Apoiador</h5>
            <!-- Botão Voltar direcionado para os Detalhes do apoiador -->
            <a asp-page="Detalhes" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">Voltar</a>
        </div>
        <div class="card-body">
            <form method="post" asp-route-id="@Model.Id">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- Dados Pessoais -->
                    <div class="col-md-6 border-end">
                        <h6 class="text-primary mb-3">Dados Pessoais</h6>

                        <div class="mb-3">
                            <label asp-for="Input.Nome" class="form-label"></label>
                            <input asp-for="Input.Nome" class="form-control" />
                            <span asp-validation-for="Input.Nome" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Cpf" class="form-label"></label>
                                <input asp-for="Input.Cpf" class="form-control" placeholder="000.000.000-00" />
                                <span asp-validation-for="Input.Cpf" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Apelido" class="form-label"></label>
                                <input asp-for="Input.Apelido" class="form-control" />
                                <span asp-validation-for="Input.Apelido" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Telefone" class="form-label"></label>
                                <input asp-for="Input.Telefone" id="txtTelefone" class="form-control" placeholder="(00) 00000-0000" />
                                <span asp-validation-for="Input.Telefone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.TelefoneFixo" class="form-label"></label>
                                <input asp-for="Input.TelefoneFixo" class="form-control" />
                                <span asp-validation-for="Input.TelefoneFixo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Email" class="form-label"></label>
                                <input asp-for="Input.Email" type="email" class="form-control" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DataNascimento" class="form-label"></label>
                                <input asp-for="Input.DataNascimento" type="date" class="form-control" />
                                <span asp-validation-for="Input.DataNascimento" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Genero" class="form-label"></label>
                                <select asp-for="Input.Genero" class="form-select">
                                    <option value="">Selecione...</option>
                                    <option value="Masculino">Masculino</option>
                                    <option value="Feminino">Feminino</option>
                                    <option value="Outro">Outro</option>
                                </select>
                                <span asp-validation-for="Input.Genero" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Profissao" class="form-label"></label>
                                <input asp-for="Input.Profissao" class="form-control" />
                                <span asp-validation-for="Input.Profissao" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StatusTexto" class="form-label font-weight-bold">Status</label>
                            <select asp-for="StatusTexto" id="selectStatus" class="form-select">
                                <option value="ATIVO">ATIVO</option>
                                <option value="INATIVO">INATIVO</option>
                            </select>
                        </div>

                        <div class="mb-3" id="containerDescricaoStatus">
                            <label asp-for="DescricaoStatus" class="form-label">
                                Motivo / Justificativa da Alteração de Status <span class="text-danger" id="asteriscoObrigatorio">*</span>
                            </label>
                            <textarea asp-for="DescricaoStatus" id="txtDescricaoStatus" class="form-control" rows="2" placeholder="Descreva o motivo da inativação ou alteração de status"></textarea>
                            <span asp-validation-for="DescricaoStatus" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Endereço e Relacionamento -->
                    <div class="col-md-6">
                        <h6 class="text-primary mb-3">Endereço & Atribuições</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Cep" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Input.Cep" id="txtCep" class="form-control" placeholder="00000-000" maxlength="9" />
                                    <button type="button" id="btnBuscarCep" class="btn btn-outline-secondary">
                                        <i class="bi bi-search"></i> Buscar
                                    </button>
                                </div>
                                <span asp-validation-for="Input.Cep" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Logradouro" class="form-label"></label>
                                <input asp-for="Input.Logradouro" id="txtLogradouro" class="form-control" />
                                <span asp-validation-for="Input.Logradouro" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.Numero" class="form-label"></label>
                                <input asp-for="Input.Numero" id="txtNumero" class="form-control" />
                                <span asp-validation-for="Input.Numero" class="text-danger"></span>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label asp-for="Input.Bairro" class="form-label"></label>
                                <input asp-for="Input.Bairro" id="txtBairro" class="form-control" />
                                <span asp-validation-for="Input.Bairro" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="Input.Cidade" class="form-label"></label>
                                <input asp-for="Input.Cidade" id="txtCidade" class="form-control" />
                                <span asp-validation-for="Input.Cidade" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Input.Uf" class="form-label"></label>
                                <input asp-for="Input.Uf" id="txtUf" class="form-control" maxlength="2" />
                                <span asp-validation-for="Input.Uf" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.PadrinhoId" class="form-label"></label>
                            <select asp-for="Input.PadrinhoId" asp-items="Model.CabosEleitorais" class="form-select">
                                <option value="">Nenhum</option>
                            </select>
                            <span asp-validation-for="Input.PadrinhoId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Observacoes" class="form-label"></label>
                            <textarea asp-for="Input.Observacoes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Input.Observacoes" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <!-- Botão Cancelar direcionado para os Detalhes do apoiador -->
                    <a asp-page="Detalhes" asp-route-id="@Model.Id" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning">Atualizar Apoiador</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectStatus = document.getElementById('selectStatus');
            const txtDescricaoStatus = document.getElementById('txtDescricaoStatus');
            const asteriscoObrigatorio = document.getElementById('asteriscoObrigatorio');
            const statusOriginal = selectStatus ? selectStatus.value : 'ATIVO';

            function atualizarObrigatoriedadeStatus() {
                if (!selectStatus) return;

                const statusAtual = selectStatus.value;
                const mudouStatus = statusAtual !== statusOriginal;
                const isInativo = statusAtual === 'INATIVO';

                if (mudouStatus || isInativo) {
                    asteriscoObrigatorio.style.display = 'inline';
                    txtDescricaoStatus.setAttribute('required', 'required');
                } else {
                    asteriscoObrigatorio.style.display = 'none';
                    txtDescricaoStatus.removeAttribute('required');
                }
            }

            if (selectStatus) {
                selectStatus.addEventListener('change', atualizarObrigatoriedadeStatus);
                atualizarObrigatoriedadeStatus();
            }

            const btnBuscarCep = document.getElementById('btnBuscarCep');
            const txtCep = document.getElementById('txtCep');

            if (btnBuscarCep && txtCep) {
                const buscarEnderecoPorCep = async () => {
                    const cep = txtCep.value.replace(/\D/g, '');

                    if (cep.length !== 8) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'warning',
                            title: 'Informe um CEP válido com 8 dígitos.',
                            showConfirmButton: false,
                            timer: 3500
                        });
                        return;
                    }

                    const originalBtnContent = btnBuscarCep.innerHTML;
                    btnBuscarCep.disabled = true;
                    btnBuscarCep.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Buscando...';

                    try {
                        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
                        if (!response.ok) throw new Error('Falha na consulta do CEP');

                        const data = await response.json();

                        if (data.erro) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'error',
                                title: 'CEP não encontrado.',
                                showConfirmButton: false,
                                timer: 3500
                            });
                            return;
                        }

                        document.getElementById('txtLogradouro').value = data.logradouro || '';
                        document.getElementById('txtBairro').value = data.bairro || '';
                        document.getElementById('txtCidade').value = data.localidade || '';
                        document.getElementById('txtUf').value = data.uf || '';

                        document.getElementById('txtNumero').focus();
                    } catch (error) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'error',
                            title: 'Erro ao buscar o CEP. Tente novamente.',
                            showConfirmButton: false,
                            timer: 3500
                        });
                    } finally {
                        btnBuscarCep.disabled = false;
                        btnBuscarCep.innerHTML = originalBtnContent;
                    }
                };

                btnBuscarCep.addEventListener('click', buscarEnderecoPorCep);

                txtCep.addEventListener('blur', function () {
                    if (this.value.replace(/\D/g, '').length === 8) {
                        buscarEnderecoPorCep();
                    }
                });
            }
        });

        const txtTelefone = document.getElementById('txtTelefone');
        const idApoiador = document.querySelector('input[name="Id"]')?.value;

        if (txtTelefone) {
            txtTelefone.addEventListener('blur', async function () {
                const telefone = this.value.trim();

                if (!telefone) return;

                try {
                    const response = await fetch(`?handler=VerificarTelefone&telefone=${encodeURIComponent(telefone)}&id=${idApoiador}`);
                    if (!response.ok) return;

                    const data = await response.json();

                    if (data.existe) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'warning',
                            title: 'Este número de telefone já pertence a outro apoiador!',
                            showConfirmButton: false,
                            timer: 4000
                        });
                    }
                } catch (error) {
                    console.error('Erro ao verificar telefone:', error);
                }
            });
        }
    </script>
}