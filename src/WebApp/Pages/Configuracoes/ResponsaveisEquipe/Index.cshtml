@page
@model WebApp.Pages.Configuracoes.ResponsaveisEquipe.IndexModel
@{
    ViewData["Title"] = "Responsáveis na Equipe";
}

<div class="container-fluid px-3 py-4">
    <!-- Header da Página -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="bi bi-person-badge-fill text-primary me-2"></i>Responsáveis na Equipe
            </h4>
            <p class="text-muted small mb-0">Cadastre e gerencie os colaboradores responsáveis pela resolução e acompanhamento das demandas.</p>
        </div>

        <button type="button" class="btn btn-primary rounded-pill px-3 fw-bold shadow-sm" onclick="abrirModalNovo()">
            <i class="bi bi-person-plus-fill me-1"></i> Adicionar Responsável
        </button>
    </div>

    <!-- Tabela de Listagem -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Responsável</th>
                        <th>Cargo / Função</th>
                        <th>Contato</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Responsaveis.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-people fs-3 d-block mb-1"></i>
                                Nenhum responsável cadastrado até o momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var resp in Model.Responsaveis)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            @resp.Nome.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@resp.Nome</div>
                                            <small class="text-muted">@(resp.Email ?? "Sem e-mail informado")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-medium px-2 py-1">
                                        @(string.IsNullOrWhiteSpace(resp.CargoOuFuncao) ? "Não informado" : resp.CargoOuFuncao)
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted d-block">@(resp.Telefone ?? "-")</small>
                                </td>
                                <td>
                                    @if (resp.Ativo)
                                    {
                                        <span class="badge bg-success-subtle text-success fw-semibold px-2 py-1">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-semibold px-2 py-1">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Inativo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-light rounded-circle p-2"
                                                title="Editar"
                                                onclick="abrirModalEditar('@resp.Id', '@resp.Nome', '@resp.Email', '@resp.Telefone', '@resp.CargoOuFuncao')">
                                            <i class="bi bi-pencil-fill text-secondary"></i>
                                        </button>

                                        <form method="post" asp-page-handler="AlternarStatus" asp-route-id="@resp.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-light rounded-circle p-2" title="@(resp.Ativo ? "Desativar" : "Ativar")">
                                                <i class="bi @(resp.Ativo ? "bi-slash-circle text-warning" : "bi-check-circle text-success")"></i>
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="Remover" asp-route-id="@resp.Id" class="d-inline form-remover" data-nome="@resp.Nome">
                                            <button type="submit" class="btn btn-sm btn-light rounded-circle p-2" title="Remover">
                                                <i class="bi bi-trash3-fill text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Salvar (Criar / Editar) -->
<div class="modal fade" id="modalResponsavel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="modalResponsavelLabel">Adicionar Responsável</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Salvar">
                <div class="modal-body py-4">
                    <input type="hidden" asp-for="Input.Id" id="inputId" />

                    <div class="mb-3">
                        <label asp-for="Input.Nome" class="form-label fw-medium text-dark">Nome Completo *</label>
                        <input asp-for="Input.Nome" id="inputNome" class="form-control rounded-3" placeholder="Ex: João da Silva" />
                        <span asp-validation-for="Input.Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.CargoOuFuncao" class="form-label fw-medium text-dark">Cargo / Função</label>
                        <input asp-for="Input.CargoOuFuncao" id="inputCargo" class="form-control rounded-3" placeholder="Ex: Coordenador de Bairro, Assessor de Obras..." />
                        <span asp-validation-for="Input.CargoOuFuncao" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Telefone" class="form-label fw-medium text-dark">Telefone / WhatsApp</label>
                            <input asp-for="Input.Telefone" id="inputTelefone" class="form-control rounded-3" placeholder="(00) 00000-0000" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Email" class="form-label fw-medium text-dark">E-mail (Opcional)</label>
                            <input asp-for="Input.Email" id="inputEmail" type="email" class="form-control rounded-3" placeholder="joao@gabinete.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let modalResponsavel;

        document.addEventListener("DOMContentLoaded", function () {
        modalResponsavel = new bootstrap.Modal(document.getElementById('modalResponsavel'));

        const formsRemover = document.querySelectorAll('.form-remover');
        formsRemover.forEach(form => {
        form.addEventListener('submit', function (e) {
        e.preventDefault();
        const nomeItem = this.getAttribute('data-nome') || 'este item';

        Swal.fire({
        title: 'Tem certeza?',
        text: `Você está prestes a remover "${nomeItem}".`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Sim, remover!',
        cancelButtonText: 'Cancelar',
        reverseButtons: true
        }).then((result) => {
        if (result.isConfirmed) {
        this.submit();
        }
        });
        });
        });
        });

        function abrirModalNovo() {
        document.getElementById('modalResponsavelLabel').innerText = "Adicionar Responsável";
        document.getElementById('inputId').value = "";
        document.getElementById('inputNome').value = "";
        document.getElementById('inputCargo').value = "";
        document.getElementById('inputTelefone').value = "";
        document.getElementById('inputEmail').value = "";
        modalResponsavel.show();
        }

        function abrirModalEditar(id, nome, email, telefone, cargo) {
        document.getElementById('modalResponsavelLabel').innerText = "Editar Responsável";
        document.getElementById('inputId').value = id;
        document.getElementById('inputNome').value = nome;
        document.getElementById('inputCargo').value = cargo || "";
        document.getElementById('inputTelefone').value = telefone || "";
        document.getElementById('inputEmail').value = email || "";
        modalResponsavel.show();
        }
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
            toast: true,
            position: 'top-end',
            icon: 'success',
            title: '@TempData["SuccessMessage"]',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
            });
            });
        </script>
    }
}