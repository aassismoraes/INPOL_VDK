@page
@model WebApp.Pages.AcessoNegadoModel
@{
    Layout = null; // Layout limpo sem os menus do sistema
    ViewData["Title"] = "Acesso Restrito";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - In|Pol</title>

    <!-- Bootstrap CSS e Ícones -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                background-color: #f8f9fa;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }

            .access-card {
                max-width: 450px;
                width: 100%;
                border-radius: 1.25rem;
            }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100 p-3">

    <div class="access-card card border-0 shadow-sm bg-white p-4 p-md-5 text-center">
        <!-- Ícone de Alerta / Bloqueio -->
        <div class="mb-3">
            <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-circle p-3 mb-2" style="width: 72px; height: 72px;">
                <i class="bi bi-shield-lock-fill display-5"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">Acesso Pendente ou Restrito</h4>
            <small class="text-muted">Sua conta não possui permissão para acessar este recurso.</small>
        </div>

        <div class="alert alert-light border text-start rounded-3 p-3 mb-4">
            <div class="d-flex gap-2">
                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                <div class="small text-secondary">
                    <strong class="d-block text-dark mb-1">O que fazer agora?</strong>
                    Se você é membro da equipe e ainda não teve seu e-mail liberado, solicite ao <strong>Administrador do Gabinete</strong> o cadastro do seu e-mail do Google no painel de usuários.
                </div>
            </div>
        </div>

        <!-- Botões de Ação -->
        <div class="d-grid gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Index" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-house-door-fill me-1"></i> Voltar ao Início
                </a>
                <a href="/Account/Logout" class="btn btn-outline-secondary btn-lg rounded-pill fw-medium">
                    <i class="bi bi-box-arrow-right me-1"></i> Sair / Trocar de Conta
                </a>
            }
            else
            {
                <a href="/Account/LoginGoogle" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                    <i class="bi bi-arrow-repeat me-1"></i> Tentar Novamente com Outra Conta
                </a>
                <a asp-page="/Login" class="btn btn-outline-secondary btn-lg rounded-pill fw-medium">
                    <i class="bi bi-arrow-left me-1"></i> Voltar para a Tela de Login
                </a>
            }
        </div>

        <div class="mt-4 pt-2">
            <small class="text-muted" style="font-size: 0.75rem;">&copy; @DateTime.Now.Year In|Pol. Todos os direitos reservados.</small>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>