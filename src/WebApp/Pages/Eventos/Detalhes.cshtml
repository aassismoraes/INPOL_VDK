@page "{id:guid}"
@using Data.Entities
@using Domain.Enums
@model WebApp.Pages.Eventos.DetalhesModel
@{
    ViewData["Title"] = "Detalhes do Evento";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <!-- Card Principal do Evento -->
        <div class="card card-mobile shadow-sm mb-4 border-0">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center justify-content-between">
                <div>
                    <span class="badge bg-success text-white rounded-pill fs-6 me-1">@Model.Evento.Tipo</span>
                    @if (Model.EventoCancelado)
                    {
                        <span class="badge bg-danger text-white rounded-pill fs-6">Cancelado</span>
                    }
                </div>
                <a asp-page="./Index" class="btn-close" aria-label="Fechar"></a>
            </div>

            <div class="card-body">
                <h4 class="fw-bold text-dark mb-3">@Model.Evento.Titulo</h4>

                <div class="p-3 bg-light rounded-3 mb-3">
                    <div class="row g-2 text-secondary small">
                        <div class="col-12 col-md-6">
                            <i class="bi bi-calendar3 me-1 text-success"></i> Data:
                            <strong class="text-dark">@Model.Evento.DataHoraInicio.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-12 col-md-6">
                            <i class="bi bi-clock me-1 text-success"></i> Horário:
                            <strong class="text-dark">
                                @Model.Evento.DataHoraInicio.ToString("HH:mm")
                                @if (Model.Evento.DataHoraFim.HasValue && Model.Evento.DataHoraFim != DateTimeOffset.MinValue)
                                {
                                    <span> às @Model.Evento.DataHoraFim.Value.ToString("HH:mm")</span>
                                }
                            </strong>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Evento.Local))
                        {
                            <div class="col-12 mt-2">
                                <i class="bi bi-geo-alt-fill me-1 text-danger"></i> Local:
                                <strong class="text-dark">@Model.Evento.Local</strong>
                            </div>
                        }

                        @{
                            var temEndereco = !string.IsNullOrWhiteSpace(Model.Evento.Logradouro)
                                           || !string.IsNullOrWhiteSpace(Model.Evento.Bairro)
                                           || !string.IsNullOrWhiteSpace(Model.Evento.Cidade);
                        }

                        @if (temEndereco)
                        {
                            <div class="col-12 mt-2 pt-2 border-top">
                                <i class="bi bi-map me-1 text-primary"></i> Endereço:
                                <span class="text-dark">
                                    @if (!string.IsNullOrWhiteSpace(Model.Evento.Logradouro))
                                    {
                                        <span>@Model.Evento.Logradouro</span>
                                        if (!string.IsNullOrWhiteSpace(Model.Evento.Numero))
                                        {
                                            <span>, nº @Model.Evento.Numero</span>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Evento.Complemento))
                                    {
                                        <span> (@Model.Evento.Complemento)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Evento.Bairro))
                                    {
                                        <span> - @Model.Evento.Bairro</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Evento.Cidade))
                                    {
                                        <span> - @Model.Evento.Cidade</span>
                                        if (!string.IsNullOrWhiteSpace(Model.Evento.Uf))
                                        {
                                            <span>/@Model.Evento.Uf</span>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Evento.Cep))
                                    {
                                        <span class="ms-1 text-muted">(CEP: @Model.Evento.Cep)</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Evento.Descricao))
                {
                    <div class="mb-3">
                        <small class="fw-bold text-muted d-block mb-1">Pauta / Observações:</small>
                        <p class="mb-0 text-dark" style="white-space: pre-line;">@Model.Evento.Descricao</p>
                    </div>
                }
            </div>
        </div>

        <!-- Painel de Relatório Rápido para Perfil Administrativo -->
        @if (!User.IsInRole(nameof(PerfilAcesso.CaboEleitoral)))
        {
            <div class="card card-mobile shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-people-fill me-2 text-primary"></i>Gestão de Presença dos Cabos Eleitorais
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <button class="btn btn-outline-primary w-100 rounded-pill text-start d-flex align-items-center justify-content-between px-3 py-2" data-bs-toggle="modal" data-bs-target="#modalConfirmados">
                                <span><i class="bi bi-check-circle me-2"></i>Confirmaram Presença</span>
                                <span class="badge bg-primary rounded-pill">@Model.CabosConfirmados.Count</span>
                            </button>
                        </div>
                        
                        @if (Model.EventoJaIniciou)
                        {
                            <div class="col-12 col-md-4">
                                <button class="btn btn-outline-success w-100 rounded-pill text-start d-flex align-items-center justify-content-between px-3 py-2" data-bs-toggle="modal" data-bs-target="#modalCheckIn">
                                    <span><i class="bi bi-geo-alt me-2"></i>Fizeram Check-in</span>
                                    <span class="badge bg-success rounded-pill">@Model.CabosCheckIn.Count</span>
                                </button>
                            </div>
                        }

                        <div class="col-12 col-md-4">
                            <button class="btn btn-outline-danger w-100 rounded-pill text-start d-flex align-items-center justify-content-between px-3 py-2" data-bs-toggle="modal" data-bs-target="#modalDesconfirmados">
                                <span><i class="bi bi-x-circle me-2"></i>Desconfirmaram</span>
                                <span class="badge bg-danger rounded-pill">@Model.CabosDesconfirmados.Count</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Histórico de Movimentos -->
        <div class="card card-mobile shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-journal-text me-2 text-success"></i>Histórico e Registro de Movimentos
                </h6>
            </div>
            <div class="card-body">

                @if (Model.Evento.Movimentacoes == null || !Model.Evento.Movimentacoes.Any())
                {
                    <div class="text-center py-4 bg-light rounded-3 mb-3">
                        <i class="bi bi-chat-left-dots text-muted fs-3"></i>
                        <p class="text-muted small mt-2 mb-0">Nenhum movimento registrado até o momento.</p>
                    </div>
                }
                else
                {
                    <div class="timeline mb-3">
                        @foreach (var mov in Model.Evento.Movimentacoes)
                        {
                            <div class="timeline-item pb-3 mb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark small">
                                        <i class="bi bi-person-circle me-1 text-secondary"></i>@(mov.UsuarioNome ?? "Sistema")
                                    </span>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i>@mov.DataMovimento.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                                <p class="text-secondary small mb-0 text-break" style="white-space: pre-line;">@mov.Descricao</p>
                            </div>
                        }
                    </div>
                }

                <hr class="my-3 text-muted opacity-25" />

                <!-- Ações para Perfil Cabo Eleitoral e Administrativo -->
                <div class="d-flex flex-wrap justify-content-end gap-2">
                    @if (Model.EventoCancelado)
                    {
                        <button type="button" class="btn btn-secondary rounded-pill fw-bold" disabled>
                            Evento Cancelado
                        </button>
                    }
                    else if (User.IsInRole(nameof(PerfilAcesso.CaboEleitoral)))
                    {
                        @if (!Model.ConfirmouPresencaAntesDoEvento && !Model.EventoJaIniciou)
                        {
                            <form method="post" asp-page-handler="ConfirmarPresenca" asp-route-id="@Model.Evento.Id">
                                <button type="submit" class="btn btn-outline-primary rounded-pill fw-bold">
                                    <i class="bi bi-check2-circle me-1"></i> Confirmar Presença Prévia
                                </button>
                            </form>
                        }

                        @if (Model.PodeDesconfirmarPresenca)
                        {
                            <button type="button" class="btn btn-outline-danger rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#modalDesconfirmar">
                                <i class="bi bi-x-circle me-1"></i> Cancelar Confirmação
                            </button>
                        }

                        @if (Model.JaFezCheckIn)
                        {
                            <button type="button" class="btn btn-success rounded-pill fw-bold" disabled>
                                <i class="bi bi-check-circle-fill me-1"></i> Check-in Realizado
                            </button>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="CheckIn" asp-route-id="@Model.Evento.Id" id="form-checkin">
                                <input type="hidden" asp-for="Latitude" id="geo-lat" />
                                <input type="hidden" asp-for="Longitude" id="geo-lng" />

                                <button type="button"
                                        class="btn btn-primary rounded-pill fw-bold shadow-sm"
                                        onclick="realizarCheckInGps()"
                                        @(Model.PodeFazerCheckIn ? "" : "disabled")
                                        title="@(Model.PodeFazerCheckIn ? "Confirmar presença presencial" : "Check-in só é permitido durante o horário do evento")">
                                    <i class="bi bi-geo-alt-fill me-1"></i> Check-in GPS
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn-success rounded-pill fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoMovimento">
                            <i class="bi bi-plus-lg me-1"></i> Registrar Movimento
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Botões de Ação Principal -->
        <div class="card card-mobile shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="d-flex gap-2">
                    <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill w-100 fw-medium">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                    @if (!User.IsInRole(nameof(PerfilAcesso.CaboEleitoral)))
                    {
                        @if (Model.EventoCancelado)
                        {
                            <button type="button" class="btn btn-warning rounded-pill w-100 fw-bold text-dark opacity-50" disabled>
                                <i class="bi bi-pencil me-1"></i> Editar
                            </button>
                        }
                        else
                        {
                            <a asp-page="./Editar" asp-route-id="@Model.Evento.Id" class="btn btn-warning rounded-pill w-100 fw-bold text-dark">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Desconfirmar Presença (Cabo Eleitoral) -->
<div class="modal fade" id="modalDesconfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">Cancelar Confirmação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="DesconfirmarPresenca" asp-route-id="@Model.Evento.Id">
                <div class="modal-body py-3">
                    <div class="mb-2">
                        <label asp-for="MotivoDesconfirmacao" class="form-label fw-medium text-dark">Informe o motivo do cancelamento</label>
                        <textarea asp-for="MotivoDesconfirmacao" class="form-control" rows="3" required placeholder="Motivo do imprevisto..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Voltar</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Confirmar Cancelamento</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modais Administrativos -->
@if (!User.IsInRole(nameof(PerfilAcesso.CaboEleitoral)))
{
    <!-- Modal Confirmados -->  
    <div class="modal fade" id="modalConfirmados" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-check-circle text-primary me-2"></i>Cabos que Confirmaram Presença</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.CabosConfirmados.Any())
                    {
                        <p class="text-muted text-center my-3">Nenhum cabo confirmou presença até ao momento.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.CabosConfirmados)
                            {
                                var telefoneFormatado = item.CaboEleitoral?.Telefone?.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "");
                                
                                <li class="list-group-item px-0 py-2 border-bottom">
                                    <strong class="d-block text-dark fs-6">
                                        <i class="bi bi-person me-1 text-secondary"></i>@(item.CaboEleitoral?.Nome ?? "Nome não informado")
                                    </strong>
                                    <div class="text-muted small ms-3">
                                        @if (!string.IsNullOrWhiteSpace(item.CaboEleitoral?.Email))
                                        {
                                            <div><i class="bi bi-envelope me-1"></i>@item.CaboEleitoral.Email</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.CaboEleitoral?.Telefone))
                                        {
                                            <div>
                                                <i class="bi bi-telephone me-1"></i>@item.CaboEleitoral.Telefone
                                                <a href="https://wa.me/55@(telefoneFormatado)" target="_blank" class="badge bg-success text-decoration-none ms-2">
                                                    <i class="bi bi-whatsapp me-1"></i>WhatsApp
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Check-in GPS -->
    @if (Model.EventoJaIniciou)
    {
        <div class="modal fade" id="modalCheckIn" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-dark"><i class="bi bi-geo-alt text-success me-2"></i>Cabos Presentes (Check-in GPS)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!Model.CabosCheckIn.Any())
                        {
                            <p class="text-muted text-center my-3">Nenhum cabo efetuou check-in ainda.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var item in Model.CabosCheckIn)
                                {
                                    var telefoneFormatado = item.CaboEleitoral?.Telefone?.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "");

                                    <li class="list-group-item px-0 py-2 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong class="d-block text-dark fs-6">
                                                    <i class="bi bi-person me-1 text-secondary"></i>@(item.CaboEleitoral?.Nome ?? "Nome não informado")
                                                </strong>
                                                <div class="text-muted small ms-3">
                                                    @if (!string.IsNullOrWhiteSpace(item.CaboEleitoral?.Email))
                                                    {
                                                        <div><i class="bi bi-envelope me-1"></i>@item.CaboEleitoral.Email</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.CaboEleitoral?.Telefone))
                                                    {
                                                        <div>
                                                            <i class="bi bi-telephone me-1"></i>@item.CaboEleitoral.Telefone
                                                            <a href="https://wa.me/55@(telefoneFormatado)" target="_blank" class="badge bg-success text-decoration-none ms-2">
                                                                <i class="bi bi-whatsapp me-1"></i>WhatsApp
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@item.DataCheckIn?.ToString("HH:mm")</span>
                                                <small class="d-block text-muted mt-1">@Math.Round(item.DistanciaMetros ?? 0)m dist.</small>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Modal Desconfirmados -->
    <div class="modal fade" id="modalDesconfirmados" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-x-circle text-danger me-2"></i>Cabos que Desconfirmaram</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @if (!Model.CabosDesconfirmados.Any())
                    {
                        <p class="text-muted text-center my-3">Nenhum cancelamento registrado.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var item in Model.CabosDesconfirmados)
                            {
                                var telefoneFormatado = item.CaboEleitoral?.Telefone?.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "");

                                <li class="list-group-item px-0 py-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="text-dark fs-6">
                                            <i class="bi bi-person me-1 text-secondary"></i>@(item.CaboEleitoral?.Nome ?? "Nome não informado")
                                        </strong>
                                        <small class="text-muted">@item.DataDesconfirmacao?.ToString("dd/MM HH:mm")</small>
                                    </div>
                                    <div class="text-muted small ms-3 mb-2">
                                        @if (!string.IsNullOrWhiteSpace(item.CaboEleitoral?.Email))
                                        {
                                            <div><i class="bi bi-envelope me-1"></i>@item.CaboEleitoral.Email</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.CaboEleitoral?.Telefone))
                                        {
                                            <div>
                                                <i class="bi bi-telephone me-1"></i>@item.CaboEleitoral.Telefone
                                                <a href="https://wa.me/55@(telefoneFormatado)" target="_blank" class="badge bg-success text-decoration-none ms-2">
                                                    <i class="bi bi-whatsapp me-1"></i>WhatsApp
                                                </a>
                                            </div>
                                        }
                                    </div>
                                    <p class="small text-danger mb-0 bg-light p-2 rounded">
                                        <strong>Motivo:</strong> @item.MotivoDesconfirmacao
                                    </p>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Registrar Movimento Geral -->
<div class="modal fade" id="modalNovoMovimento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-journal-plus text-success me-2"></i>Novo Movimento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="AdicionarMovimento" asp-route-id="@Model.Evento.Id">
                <div class="modal-body py-3">
                    <div class="mb-2">
                        <label asp-for="NovaMovimentacao" class="form-label fw-medium text-dark">Descrição / Observação</label>
                        <textarea asp-for="NovaMovimentacao" class="form-control" rows="4" placeholder="Digite aqui a atualização do evento..."></textarea>
                        <span asp-validation-for="NovaMovimentacao" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-send me-1"></i> Salvar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function realizarCheckInGps() {
            if (!navigator.geolocation) {
                Swal.fire('Erro', 'A geolocalização não é suportada pelo seu navegador/dispositivo.', 'error');
                return;
            }

            Swal.fire({
                title: 'Validando posição...',
                text: 'Obtendo coordenadas GPS para checar a proximidade do evento...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    document.getElementById('geo-lat').value = position.coords.latitude;
                    document.getElementById('geo-lng').value = position.coords.longitude;
                    document.getElementById('form-checkin').submit();
                },
                (error) => {
                    Swal.fire('Sinal GPS Indisponível', 'Ative a localização de alta precisão do seu aparelho e tente novamente.', 'error');
                },
                { enableHighAccuracy: true, timeout: 12000 }
            );
        }
    </script>
}