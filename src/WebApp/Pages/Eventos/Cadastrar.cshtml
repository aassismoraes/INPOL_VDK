@page
@model WebApp.Pages.Eventos.CadastrarModel
@using Domain.Enums
@{
    ViewData["Title"] = "Novo Evento";
}

<!-- Cabeçalho Alinhado no Padrão do Sistema -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-calendar-plus-fill me-2"></i>Novo Evento / Agenda</h4>
        <small class="text-muted fw-semibold">Preencha as informações para agendar um novo compromisso</small>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary rounded-pill shadow-sm fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Voltar
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <form method="post" id="formCadastrarEvento">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3" role="alert"></div>

                    <!-- Campos Ocultos para Coordenadas GPS -->
                    <input type="hidden" asp-for="Latitude" id="hiddenLatitude" />
                    <input type="hidden" asp-for="Longitude" id="hiddenLongitude" />

                    <!-- Título do Evento -->
                    <div class="mb-3">
                        <label asp-for="EventoInput.Titulo" class="form-label fw-medium"></label>
                        <input asp-for="EventoInput.Titulo" class="form-control form-control-lg" placeholder="Ex: Caminhada no Bairro da Paz" />
                        <span asp-validation-for="EventoInput.Titulo" class="text-danger small"></span>
                    </div>

                    <!-- Tipo e Nome do Local -->
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="EventoInput.Tipo" class="form-label fw-medium"></label>
                            <select asp-for="EventoInput.Tipo" asp-items="Html.GetEnumSelectList<TipoEvento>()" class="form-select">
                                <option value="">Selecione...</option>
                            </select>
                            <span asp-validation-for="EventoInput.Tipo" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="EventoInput.Local" class="form-label fw-medium">Nome do Local</label>
                            <input asp-for="EventoInput.Local" class="form-control" placeholder="Ex: Assoc. de Moradores" />
                            <span asp-validation-for="EventoInput.Local" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Datas de Início e Fim -->
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="EventoInput.DataHoraInicio" class="form-label fw-medium">Início</label>
                            <input asp-for="EventoInput.DataHoraInicio"
                                   class="form-control"
                                   type="datetime-local"
                                   step="60"
                                   value="@Model.EventoInput.DataHoraInicio.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="EventoInput.DataHoraInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="EventoInput.DataHoraFim" class="form-label fw-medium">Fim</label>
                            <input asp-for="EventoInput.DataHoraFim"
                                   class="form-control"
                                   type="datetime-local"
                                   step="60"
                                   value="@(Model.EventoInput.DataHoraFim.HasValue ? Model.EventoInput.DataHoraFim.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                            <span asp-validation-for="EventoInput.DataHoraFim" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bloco de Regras de Check-in -->
                    <div class="row g-2 mb-3">
                        <div class="col-12">
                            <label asp-for="EventoInput.MinutosAntecedenciaCheckIn" class="form-label fw-medium">
                                Tolerância para Check-in GPS (Minutos de Antecedência)
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-clock-history text-muted"></i></span>
                                <input asp-for="EventoInput.MinutosAntecedenciaCheckIn"
                                       type="number"
                                       min="0"
                                       max="1440"
                                       class="form-control"
                                       placeholder="20" />
                                <span class="input-group-text bg-light text-muted">minutos antes</span>
                            </div>
                            <span asp-validation-for="EventoInput.MinutosAntecedenciaCheckIn" class="text-danger small"></span>
                            <small class="text-muted d-block mt-1">Tempo de antecedência ao horário de início do evento em que a geolocalização e check-in serão autorizados.</small>
                        </div>
                    </div>

                    <!-- Bloco de Endereço Detalhado e GPS -->
                    <hr class="my-4 text-muted opacity-25" />

                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-geo-alt-fill me-1"></i>ENDEREÇO DO EVENTO</h6>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span id="badgeGps" class="badge bg-secondary py-2"><i class="bi bi-satellite me-1"></i>GPS Pendente</span>
                            <button type="button" class="btn btn-sm btn-info text-white rounded-pill fw-medium d-none" id="btnVerMapa" onclick="abrirMapa()">
                                <i class="bi bi-map me-1"></i> Ver/Ajustar Mapa
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-medium" onclick="obterLocalizacaoAtual()">
                                <i class="bi bi-crosshair me-1"></i> Meu local atual
                            </button>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6 col-md-5">
                            <label asp-for="EventoInput.Cep" class="form-label fw-medium">CEP</label>
                            <div class="input-group">
                                <input asp-for="EventoInput.Cep" id="txtCep" class="form-control" placeholder="00000-000" maxlength="9" />
                                <button class="btn btn-outline-secondary" type="button" id="btnBuscarCep" title="Buscar por CEP">
                                    <i class="bi bi-search" id="iconBuscarCep"></i>
                                    <span class="spinner-border spinner-border-sm d-none" id="spinBuscarCep" role="status" aria-hidden="true"></span>
                                </button>
                            </div>
                            <span asp-validation-for="EventoInput.Cep" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <!-- Campo de Logradouro com Autocomplete -->
                        <div class="col-12 col-sm-8 col-md-9">
                            <label asp-for="EventoInput.Logradouro" class="form-label fw-medium">Logradouro / Rua</label>
                            <div class="input-group position-relative">
                                <input asp-for="EventoInput.Logradouro" id="txtLogradouro" class="form-control" placeholder="Rua, Avenida, Praça..." autocomplete="off" />
                                <button class="btn btn-outline-secondary" type="button" id="btnBuscarEndereco" title="Buscar coordenadas por este endereço">
                                    <i class="bi bi-search" id="iconBuscarEndereco"></i>
                                    <span class="spinner-border spinner-border-sm d-none" id="spinBuscarEndereco" role="status" aria-hidden="true"></span>
                                </button>
                                <!-- Lista de Autocomplete -->
                                <ul id="listaAutocompleteEndereco" class="dropdown-menu w-100 shadow-lg" style="max-height: 280px; overflow-y: auto; position: absolute; top: 100%; z-index: 1050;"></ul>
                            </div>
                            <span asp-validation-for="EventoInput.Logradouro" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-4 col-md-3">
                            <label asp-for="EventoInput.Numero" class="form-label fw-medium">Número</label>
                            <input asp-for="EventoInput.Numero" id="txtNumero" class="form-control" placeholder="S/N" />
                            <span asp-validation-for="EventoInput.Numero" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="EventoInput.Complemento" class="form-label fw-medium">Complemento</label>
                            <input asp-for="EventoInput.Complemento" class="form-control" placeholder="Apto, Bloco, Quadra..." />
                            <span asp-validation-for="EventoInput.Complemento" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="EventoInput.Bairro" class="form-label fw-medium">Bairro</label>
                            <input asp-for="EventoInput.Bairro" id="txtBairro" class="form-control" placeholder="Bairro" />
                            <span asp-validation-for="EventoInput.Bairro" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-12 col-sm-8 col-md-9">
                            <label asp-for="EventoInput.Cidade" class="form-label fw-medium">Cidade</label>
                            <input asp-for="EventoInput.Cidade" id="txtCidade" class="form-control" placeholder="Cidade" />
                            <span asp-validation-for="EventoInput.Cidade" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-sm-4 col-md-3">
                            <label asp-for="EventoInput.Uf" class="form-label fw-medium">UF</label>
                            <input asp-for="EventoInput.Uf" id="txtUf" class="form-control text-uppercase" placeholder="RJ" maxlength="2" />
                            <span asp-validation-for="EventoInput.Uf" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bloco Cabos Eleitorais Convidados -->
                    <hr class="my-4 text-muted opacity-25" />
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold text-primary mb-0"><i class="bi bi-people-fill me-1"></i>CABOS ELEITORAIS CONVIDADOS</h6>
                        <span class="badge bg-light text-dark border fw-medium" id="cntSelecionados">0 selecionados</span>
                    </div>

                    <div class="mb-3">
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="filtroCabos" class="form-control border-start-0" placeholder="Filtrar por nome ou área/bairro..." onkeyup="filtrarCabosEleitorais()" />
                        </div>

                        <div class="border rounded-3 p-2 bg-light" style="max-height: 220px; overflow-y: auto;">
                            @if (!Model.CabosEleitoraisDisponiveis.Any())
                            {
                                <small class="text-muted d-block text-center py-3">Nenhum cabo eleitoral ativo cadastrado.</small>
                            }
                            else
                            {
                                @foreach (var cabo in Model.CabosEleitoraisDisponiveis)
                                {
                                    <div class="form-check item-cabo py-2 border-bottom border-light-subtle">
                                        <input class="form-check-input chk-cabo"
                                               type="checkbox"
                                               name="EventoInput.CabosEleitoraisIds"
                                               value="@cabo.Id"
                                               id="cabo_@cabo.Id"
                                               onchange="atualizarContadorCabos()" />
                                        <label class="form-check-label d-flex justify-content-between align-items-center w-100 pe-2 cursor-pointer" for="cabo_@cabo.Id">
                                            <span class="fw-medium text-dark label-nome">@cabo.Nome</span>
                                            <small class="text-muted label-info">
                                                @(string.IsNullOrWhiteSpace(cabo.AreaInfluencia) ? cabo.Bairro ?? "Geral" : cabo.AreaInfluencia)
                                            </small>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Pauta / Descrição -->
                    <hr class="my-4 text-muted opacity-25" />
                    <div class="mb-3">
                        <label asp-for="EventoInput.Descricao" class="form-label fw-medium">Descrição / Pauta</label>
                        <textarea asp-for="EventoInput.Descricao" class="form-control" rows="3" placeholder="Observações e pauta da reunião..."></textarea>
                        <span asp-validation-for="EventoInput.Descricao" class="text-danger small"></span>
                    </div>

                    <!-- Botão de Ação -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-warning text-dark btn-lg rounded-pill fw-bold py-3 shadow-sm">
                            <i class="bi bi-calendar-check-fill me-1"></i> Agendar Evento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mapa Interativo -->
<div class="modal fade" id="modalMapa" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light pb-2">
                <h5 class="modal-title fw-bold text-primary"><i class="bi bi-geo-alt me-1"></i> Confirmar Localização</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0 position-relative">
                <div id="mapaPreview" style="height: 400px; width: 100%; z-index: 1;"></div>
                <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-white bg-opacity-75 text-center small fw-bold text-primary" style="z-index: 1000; pointer-events: none;">
                    <i class="bi bi-arrows-move me-1"></i> Você pode arrastar o marcador azul para ajustar o local exato.
                </div>
            </div>
            <div class="modal-footer bg-light pt-2 pb-2">
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Confirmar Posição</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- CSS e JS do Leaflet (Mapa) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        let map;
        let marker;

        const ufMap = {
            "Acre": "AC", "Alagoas": "AL", "Amapá": "AP", "Amazonas": "AM", "Bahia": "BA", "Ceará": "CE", "Distrito Federal": "DF",
            "Espírito Santo": "ES", "Goiás": "GO", "Maranhão": "MA", "Mato Grosso": "MT", "Mato Grosso do Sul": "MS", "Minas Gerais": "MG",
            "Pará": "PA", "Paraíba": "PB", "Paraná": "PR", "Pernambuco": "PE", "Piauí": "PI", "Rio de Janeiro": "RJ", "Rio Grande do Norte": "RN",
            "Rio Grande do Sul": "RS", "Rondônia": "RO", "Roraima": "RR", "Santa Catarina": "SC", "São Paulo": "SP", "Sergipe": "SE", "Tocantins": "TO"
        };

        document.addEventListener("DOMContentLoaded", function() {
            const txtCep = document.getElementById("txtCep");
            const btnBuscarCep = document.getElementById("btnBuscarCep");
            const iconBuscarCep = document.getElementById("iconBuscarCep");
            const spinBuscarCep = document.getElementById("spinBuscarCep");

            const txtLogradouro = document.getElementById("txtLogradouro");
            const btnBuscarEndereco = document.getElementById("btnBuscarEndereco");
            const iconBuscarEndereco = document.getElementById("iconBuscarEndereco");
            const spinBuscarEndereco = document.getElementById("spinBuscarEndereco");
            const listaAutocomplete = document.getElementById("listaAutocompleteEndereco");

            const txtNumero = document.getElementById("txtNumero");
            const txtCidade = document.getElementById("txtCidade");
            const formCadastrar = document.getElementById("formCadastrarEvento");
            const modalElement = document.getElementById('modalMapa');

            if (modalElement) {
                modalElement.addEventListener('shown.bs.modal', function () {
                    if (map) { map.invalidateSize(); }
                });
            }

            // MÁSCARA DO CEP
            if (txtCep) {
                txtCep.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.length > 5) {
                        value = value.substring(0, 5) + '-' + value.substring(5, 8);
                    }
                    e.target.value = value;
                });
            }

            // BUSCAR GPS NO BLUR DOS CAMPOS PADRÃO
            if (txtNumero) txtNumero.addEventListener("blur", buscarCoordenadasDaMorada);
            if (txtCidade) txtCidade.addEventListener("blur", buscarCoordenadasDaMorada);

            // VALIDAÇÃO ANTES DO SUBMIT (GARANTE QUE TEM GPS)
            if (formCadastrar) {
                formCadastrar.addEventListener("submit", async function(e) {
                    const lat = document.getElementById("hiddenLatitude").value;
                    const logradouro = document.getElementById("txtLogradouro").value;

                    if (!lat && logradouro) {
                        e.preventDefault();
                        await buscarCoordenadasDaMorada();
                        this.submit();
                    }
                });
            }

            // AUTOCOMPLETE DE ENDEREÇO
            let debounceTimer;
            if (txtLogradouro && listaAutocomplete) {
                txtLogradouro.addEventListener("input", function() {
                    clearTimeout(debounceTimer);
                    const query = this.value;

                    if (query.length < 4) {
                        listaAutocomplete.classList.remove("show");
                        return;
                    }

                    debounceTimer = setTimeout(async () => {
                        const uf = document.getElementById("txtUf").value;
                        const cidade = document.getElementById("txtCidade").value;

                        let searchQuery = query;
                        if (cidade) searchQuery += `, ${cidade}`;
                        if (uf) searchQuery += `, ${uf}`;

                        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(searchQuery)}&addressdetails=1&countrycodes=br&limit=5`;

                        try {
                            const response = await fetch(url);
                            const data = await response.json();

                            listaAutocomplete.innerHTML = "";
                            if (data && data.length > 0) {
                                data.forEach(item => {
                                    const addr = item.address;
                                    const nomeRua = addr.road || addr.pedestrian || item.name || '';
                                    const bairro = addr.suburb || addr.neighbourhood || addr.city_district || '';
                                    const cid = addr.city || addr.town || addr.village || addr.municipality || '';
                                    const estado = addr.state || '';

                                    const li = document.createElement("li");
                                    li.innerHTML = `<a class="dropdown-item" style="cursor: pointer; white-space: normal; border-bottom: 1px solid #eee;">
                                        <strong>${nomeRua}</strong><br>
                                        <small class="text-muted">${bairro ? bairro + ' - ' : ''}${cid} - ${estado}</small>
                                    </a>`;

                                    li.addEventListener("click", async function() {
                                        txtLogradouro.value = nomeRua;
                                        document.getElementById("hiddenLatitude").value = item.lat;
                                        document.getElementById("hiddenLongitude").value = item.lon;

                                        listaAutocomplete.classList.remove("show");

                                        await preencherEnderecoPorCoordenadas(item.lat, item.lon);
                                        atualizarInterfaceGps(true);
                                        abrirMapa();
                                    });
                                    listaAutocomplete.appendChild(li);
                                });
                                listaAutocomplete.classList.add("show");
                            } else {
                                listaAutocomplete.classList.remove("show");
                            }
                        } catch(e) {
                            console.error("Erro no autocomplete:", e);
                        }
                    }, 600);
                });

                document.addEventListener("click", function(e) {
                    if (e.target !== txtLogradouro && !listaAutocomplete.contains(e.target)) {
                        listaAutocomplete.classList.remove("show");
                    }
                });
            }

            // FUNÇÃO: BUSCAR POR CEP
            async function buscarCep() {
                const cep = txtCep.value.replace(/\D/g, '');
                if (cep.length !== 8) return;

                if (iconBuscarCep) iconBuscarCep.classList.add("d-none");
                if (spinBuscarCep) spinBuscarCep.classList.remove("d-none");
                if (btnBuscarCep) btnBuscarCep.disabled = true;

                try {
                    const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
                    const data = await response.json();

                    if (!data.erro) {
                        document.getElementById("txtLogradouro").value = data.logradouro || '';
                        document.getElementById("txtBairro").value = data.bairro || '';
                        document.getElementById("txtCidade").value = data.localidade || '';
                        document.getElementById("txtUf").value = data.uf || '';

                        buscarCoordenadasDaMorada();
                    }
                } catch (e) {
                    console.error("Erro ao buscar CEP:", e);
                } finally {
                    if (iconBuscarCep) iconBuscarCep.classList.remove("d-none");
                    if (spinBuscarCep) spinBuscarCep.classList.add("d-none");
                    if (btnBuscarCep) btnBuscarCep.disabled = false;
                }
            }

            btnBuscarCep?.addEventListener("click", buscarCep);
            txtCep?.addEventListener("blur", buscarCep);

            // FUNÇÃO: BUSCAR POR ENDEREÇO LIVRE (LUPA NO LOGRADOURO)
            btnBuscarEndereco?.addEventListener("click", async function() {
                const rua = document.getElementById("txtLogradouro").value;
                const cidade = document.getElementById("txtCidade").value;
                const uf = document.getElementById("txtUf").value;

                if (!rua) {
                    alert("Digite ao menos o Logradouro/Rua para realizar a busca.");
                    return;
                }

                if (iconBuscarEndereco) iconBuscarEndereco.classList.add("d-none");
                if (spinBuscarEndereco) spinBuscarEndereco.classList.remove("d-none");
                btnBuscarEndereco.disabled = true;

                const query = `${rua}${cidade ? ', ' + cidade : ''}${uf ? ', ' + uf : ''}, Brasil`;
                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&addressdetails=1`;

                try {
                    const response = await fetch(url);
                    const data = await response.json();

                    if (data && data.length > 0) {
                        const lat = data[0].lat;
                        const lng = data[0].lon;
                        document.getElementById("hiddenLatitude").value = lat;
                        document.getElementById("hiddenLongitude").value = lng;

                        await preencherEnderecoPorCoordenadas(lat, lng);
                        atualizarInterfaceGps(true);
                        abrirMapa();
                    } else {
                        atualizarInterfaceGps(false);
                        alert("Endereço não encontrado no mapa.");
                    }
                } catch (e) {
                    console.error("Erro na busca por endereço:", e);
                    atualizarInterfaceGps(false);
                } finally {
                    if (iconBuscarEndereco) iconBuscarEndereco.classList.remove("d-none");
                    if (spinBuscarEndereco) spinBuscarEndereco.classList.add("d-none");
                    btnBuscarEndereco.disabled = false;
                }
            });
        });

        // REVERSE GEOCODING (ATUALIZA O FORMULÁRIO COM BASE NO GPS)
        async function preencherEnderecoPorCoordenadas(lat, lng) {
            try {
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`);
                const data = await response.json();

                if (data && data.address) {
                    const addr = data.address;
                    if (addr.road || addr.pedestrian) document.getElementById("txtLogradouro").value = addr.road || addr.pedestrian || '';
                    if (addr.suburb || addr.neighbourhood || addr.city_district) document.getElementById("txtBairro").value = addr.suburb || addr.neighbourhood || addr.city_district || '';
                    if (addr.city || addr.town || addr.village || addr.municipality) document.getElementById("txtCidade").value = addr.city || addr.town || addr.village || addr.municipality || '';
                    if (addr.house_number) document.getElementById("txtNumero").value = addr.house_number;

                    if (addr.state && ufMap[addr.state]) {
                        document.getElementById("txtUf").value = ufMap[addr.state];
                    } else if (addr.state) {
                        document.getElementById("txtUf").value = addr.state.substring(0, 2).toUpperCase(); // Fallback genérico
                    }

                    if (addr.postcode) {
                        let cepStr = addr.postcode.replace(/\D/g, '');
                        if (cepStr.length === 8) {
                            cepStr = cepStr.substring(0, 5) + '-' + cepStr.substring(5, 8);
                        }
                        document.getElementById("txtCep").value = cepStr;
                    }
                }
            } catch (e) {
                console.error("Erro ao buscar endereço reverso:", e);
            }
        }

        // MAPA LEAFLET E EVENTO DE DRAG DO MARCADOR
        function inicializarOuAtualizarMapa(lat, lng) {
            if (!map) {
                map = L.map('mapaPreview').setView([lat, lng], 17);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                marker = L.marker([lat, lng], { draggable: true }).addTo(map);

                marker.on('dragend', async function () {
                    const position = marker.getLatLng();
                    document.getElementById("hiddenLatitude").value = position.lat;
                    document.getElementById("hiddenLongitude").value = position.lng;

                    // Altera o formulário com base na nova posição do Pin
                    await preencherEnderecoPorCoordenadas(position.lat, position.lng);
                });
            } else {
                map.setView([lat, lng], 17);
                marker.setLatLng([lat, lng]);
            }
        }

        function abrirMapa() {
            let lat = document.getElementById("hiddenLatitude").value;
            let lng = document.getElementById("hiddenLongitude").value;

            if (lat) lat = lat.replace(',', '.');
            if (lng) lng = lng.replace(',', '.');

            if (lat && lng) {
                const modal = new bootstrap.Modal(document.getElementById('modalMapa'));
                modal.show();
                inicializarOuAtualizarMapa(parseFloat(lat), parseFloat(lng));
            }
        }

        function atualizarInterfaceGps(encontrado, carregando = false) {
            const badgeGps = document.getElementById("badgeGps");
            const btnVerMapa = document.getElementById("btnVerMapa");

            if (carregando) {
                if (badgeGps) {
                    badgeGps.className = "badge bg-warning text-dark py-2";
                    badgeGps.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processando GPS...';
                }
                if (btnVerMapa) btnVerMapa.classList.add("d-none");
                return;
            }

            if (encontrado) {
                if (badgeGps) {
                    badgeGps.className = "badge bg-success py-2";
                    badgeGps.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>GPS Registrado';
                }
                if (btnVerMapa) btnVerMapa.classList.remove("d-none");
            } else {
                if (badgeGps) {
                    badgeGps.className = "badge bg-danger py-2";
                    badgeGps.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i>GPS Não Encontrado';
                }
                if (btnVerMapa) btnVerMapa.classList.add("d-none");
            }
        }

        async function buscarCoordenadasDaMorada() {
            const rua = document.getElementById("txtLogradouro").value;
            const numero = document.getElementById("txtNumero").value;
            const cidade = document.getElementById("txtCidade").value;
            const uf = document.getElementById("txtUf").value;

            if (!rua || !cidade || !uf) return;

            atualizarInterfaceGps(false, true);

            const query = `${numero ? numero + ' ' : ''}${rua}, ${cidade}, ${uf}, Brasil`;
            const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`;

            try {
                const response = await fetch(url);
                const data = await response.json();

                if (data && data.length > 0) {
                    document.getElementById("hiddenLatitude").value = data[0].lat;
                    document.getElementById("hiddenLongitude").value = data[0].lon;

                    atualizarInterfaceGps(true);
                } else {
                    atualizarInterfaceGps(false);
                }
            } catch (e) {
                console.error("Erro ao buscar coordenadas:", e);
                atualizarInterfaceGps(false);
            }
        }

        function obterLocalizacaoAtual() {
            if (!navigator.geolocation) {
                alert('A geolocalização não é suportada pelo seu navegador.');
                return;
            }

            atualizarInterfaceGps(false, true);

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    document.getElementById("hiddenLatitude").value = lat.toString().replace(',', '.');
                    document.getElementById("hiddenLongitude").value = lng.toString().replace(',', '.');

                    atualizarInterfaceGps(true);

                    // Preenche todo o endereço reverso
                    await preencherEnderecoPorCoordenadas(lat, lng);

                    abrirMapa();
                },
                (error) => {
                    console.error("Erro ao capturar localização do dispositivo:", error);
                    atualizarInterfaceGps(false);
                    alert('Não foi possível obter a sua localização atual. Verifique as permissões de localização do navegador.');
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        }

        // Cabos Eleitorais...
        function atualizarContadorCabos() {
            const checados = document.querySelectorAll('.chk-cabo:checked').length;
            document.getElementById('cntSelecionados').innerText = `${checados} selecionado(s)`;
        }

        function filtrarCabosEleitorais() {
            const termo = document.getElementById('filtroCabos').value.toLowerCase();
            const itens = document.querySelectorAll('.item-cabo');

            itens.forEach(item => {
                const nome = item.querySelector('.label-nome')?.innerText.toLowerCase() || '';
                const info = item.querySelector('.label-info')?.innerText.toLowerCase() || '';

                if (nome.includes(termo) || info.includes(termo)) {
                    item.classList.remove('d-none');
                } else {
                    item.classList.add('d-none');
                }
            });
        }
    </script>
}